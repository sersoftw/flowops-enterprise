{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowops.example/contracts/v1/InventoryRejected.schema.json",
  "title": "InventoryRejected v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateId",
    "correlationId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "eventType": {
      "const": "InventoryRejected"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "causationId",
        "reason"
      ],
      "properties": {
        "causationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "reason": {
          "enum": [
            "INSUFFICIENT_STOCK",
            "PRODUCT_NOT_FOUND",
            "RESERVATION_RELEASED",
            "RESERVATION_CONFLICT"
          ]
        }
      }
    }
  }
}
